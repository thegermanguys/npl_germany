# Neon Postgres pooled connection string (runtime). From Vercel/Neon.
# Do not commit a live value. Copy this file to .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional direct (non-pooler) URL for `npm run db:setup` if DDL needs it.
# DATABASE_URL_UNPOOLED=
# DIRECT_URL=

# Random string used to sign session cookies. Generate your own.
AUTH_SECRET=replace-with-a-long-random-string

# Used only by `npm run db:setup` to create the league admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
